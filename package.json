{
  "name": "pod-router",
  "type": "module",
  "version": "0.1.0",
  "description": "A self-contained component level router for Vue.js Single Page Applications.",
  "author": "booploops",
  "license": "ISC",
  "homepage": "https://github.com/booploops/pod-router#readme",
  "keywords": [
    "router",
    "spa-router",
    "vue-spa-router"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/booploops/pod-router.git"
  },
  "bugs": {
    "url": "https://github.com/booploops/pod-router/issues"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "play": "vite",
    "test": "vitest",
    "typecheck": "vue-tsc --noEmit",
    "release": "bumpp && pnpm publish",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/browser-playwright": "^4.0.18",
    "bumpp": "^10.4.1",
    "playwright": "^1.58.2",
    "tsdown": "^0.18.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.0.18",
    "vitest-browser-vue": "^2.0.2",
    "vue": "^3.5.28",
    "vue-tsc": "^3.2.5"
  },
  "dependencies": {
    "rou3": "^0.7.12"
  }
}
